<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：托盘应用无控制台黑窗（OutputType=Exe 启动会弹出控制台窗口）。诊断走文件日志。
         不影响 WebApplication/WinForms 行为，仅决定 PE 子系统（Console→Windows）。 -->
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows：托盘模式使用 WinForms NotifyIcon（Windows 专属 API）。
         项目本就 Windows-only（NSSM/计划任务/single-file win-x64），无跨平台影响。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- exe 图标（资源管理器显示）；托盘图标从嵌入资源读取（见下方 Resource） -->
    <ApplicationIcon>..\..\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 单文件发布：托管程序集打包进 exe，native 依赖内嵌，启用压缩减体积。
       config.json 与 logs/ 保留在 exe 外部以便编辑与写入。 -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="3.21.210" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- 配置文件不随构建复制；发布时仍复制到输出目录以便部署初始化 -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- 单文件发布默认把内容文件归入 bundle：.ico 会被 GenerateBundle 嵌进 exe 并从磁盘输出移除
           （favicon.ico 曾因此在发布包丢失），显式排除保证 wwwroot 全部文件外置落盘。 -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- 托盘/关于图标：EmbeddedResource + LogicalName 让 app.ico 成为顶层 manifest 资源。
       注意：<Resource> 项会被 SDK 打包进 *.g.resources 容器（顶层 GetManifestResourceNames 看不到），
       故必须用 EmbeddedResource。TrayHost.LoadAppIcon 用 GetManifestResourceStream("app.ico") 读取。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\app.ico" Link="app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 测试项目访问 internal（DataDirectoryResolver.ApplyUsersModify / EnsureSharedWritable 等） -->
  <ItemGroup>
    <InternalsVisibleTo Include="McpDbTools.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\admin\favicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
